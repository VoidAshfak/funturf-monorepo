# =============================================================================
# FunTurf web client (Next.js) — environment template
# =============================================================================
# Copy to `.env` in this same folder (frontend-engine/) and fill in.
#
#   cp .env.example .env
#
# On Vercel, set the same keys in Project Settings -> Environment Variables.
#
# NEXT_PUBLIC_ PREFIX: variables with that prefix are inlined into the JavaScript
# bundle at build time and are therefore PUBLIC — visible to anyone who opens
# devtools. Never put a secret behind that prefix. Everything without it is
# server-only (route handlers, server components) and stays on the server.
#
# Also note: NEXT_PUBLIC_ values are baked in at BUILD time, not read at runtime.
# Changing one requires a rebuild/redeploy, not just a restart.
# =============================================================================


# --- Backend API ----------------------------------------------------------------
# REQUIRED. Base URL of the Express API, including the /api/v1 suffix. Read at
# every call site (src/utils/getData.js, the NextAuth route, and the RTK Query
# base query in src/store/api/apiSlice.js), so switching environments is this one
# line. Public by necessity — the browser calls it directly.
#   local:      http://localhost:8080/api/v1
#   deployed:   https://your-api.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# This app's OWN origin. Used to build absolute URLs (share links, metadata).
#   local:      http://localhost:3000
#   deployed:   https://your-frontend.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# --- NextAuth -----------------------------------------------------------------------
# REQUIRED. Signs and encrypts the session JWT. Auth silently misbehaves with a
# placeholder value, so generate a real one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Server-only — never expose it. Use a DIFFERENT value per environment.
NEXTAUTH_SECRET=

# Canonical origin NextAuth builds callback URLs from. Vercel usually infers it,
# but set it explicitly for a custom domain or any non-standard local port.
#   local:      http://localhost:3000
#   deployed:   https://your-frontend.vercel.app
NEXTAUTH_URL=http://localhost:3000


# --- Image uploads ---------------------------------------------------------------------
# REQUIRED for signup and turf creation. Key for imgbb, used server-side only by
# the internal route src/app/api/upload/route.js — the browser posts the file to
# that route, which forwards it to imgbb, so the key never reaches the client.
# Free key: https://api.imgbb.com/
IMGBB_API_KEY=


# --- AI text rephrasing (optional) --------------------------------------------------------
# Powers src/app/api/ai/rephrase/route.js (event/venue description polish). The
# feature is skipped when no key is set — nothing else breaks.
#
# Provider is auto-detected from whichever key is present; set AI_PROVIDER only
# to force one when both are configured.
# AI_PROVIDER=groq|gemini
AI_PROVIDER=

# Groq — free key at https://console.groq.com
# GROQ_MODEL defaults to llama-3.3-70b-versatile.
GROQ_API_KEY=
GROQ_MODEL=

# Google Gemini — free key at https://aistudio.google.com
# GEMINI_MODEL defaults to gemini-2.0-flash.
GEMINI_API_KEY=
GEMINI_MODEL=
