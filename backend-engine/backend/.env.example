# =============================================================================
# FunTurf API — environment template
# =============================================================================
# Copy to `.env` in this same folder (backend-engine/backend/) and fill in.
# `.env` is gitignored; this file is committed, so NEVER put a real secret here.
#
#   cp .env.example .env
#
# On Render, set the same keys in the service's Environment tab — the .env file
# is not deployed. Anything marked REQUIRED must be present or the API will not
# boot (or will boot broken). Everything else has a working default in code.
# =============================================================================


# --- Core ---------------------------------------------------------------------

# Port the API listens on. Render injects its own PORT; leave this for local use.
PORT=8080

# `production` turns OFF Swagger docs and the mailer's log-only fallback, and
# switches the logger to JSON. NOTE: this repo's local .env has historically set
# `production` even on a laptop, which is why DOCS_ENABLED and MAIL_DEV_LOG exist
# as explicit opt-ins below. Prefer `development` locally on a fresh setup.
NODE_ENV=development

# winston level: error | warn | info | http | verbose | debug | silly
# Default: debug.
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call this API (REST +
# Socket.IO share it — src/utils/corsOrigins.js). No trailing slashes needed;
# they are stripped. Unset falls back to localhost:3000 + the Vercel frontend.
# Never set this to "*".
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Minutes east of UTC used for all "today"/slot-grid maths (src/utils/appTime.js).
# Default 360 = UTC+6, Asia/Dhaka. Only change if the product leaves Bangladesh.
APP_TZ_OFFSET_MINUTES=360


# --- PostgreSQL (the live datastore) -------------------------------------------
# REQUIRED. Both must be set — Prisma reads them from prisma/postgresql/schema.prisma.
#
# POSTGRESQL_DATABASE_URL is what the running app uses, and is the one that would
# point at a PgBouncer pooler. POSTGRESQL_DIRECT_URL is the unpooled connection
# used by the Prisma CLI (db push / migrate) and by admin scripts — those must
# never go through a pooler or you get `prepared statement "s0" already exists`.
# They are identical today because no pooler exists yet.
POSTGRESQL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRESQL_DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Prisma connection pool (src/prisma.js). The managed instance allows 20
# connections with 3 reserved for superusers, so this app's budget is 17. A
# restart briefly doubles the pool, hence the conservative default.
# DIVIDE these by the instance count if you ever scale out. Defaults: 6 / 20 / 10.
PG_CONNECTION_LIMIT=6
PG_POOL_TIMEOUT=20
PG_CONNECT_TIMEOUT=10


# --- MongoDB (DEPRECATED) ------------------------------------------------------
# Legacy datasource, still referenced by a few old controllers. Do not write new
# code against it. Only needed if you run `npm run prisma:generate:mongo`.
MONGO_DATABASE_URL=


# --- Auth ----------------------------------------------------------------------
# REQUIRED. Two independent secrets — reusing one value for both means a stolen
# access token can be replayed as a refresh token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Lifetimes, in the `ms` string format jsonwebtoken accepts (e.g. 15m, 1d, 10d).
# Short access token + long refresh token is the point of the split.
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d


# --- Redis (optional) ----------------------------------------------------------
# Unset = in-memory node-cache, which is correct for a single instance. Set a
# Redis URL (Upstash / Redis Cloud) to share cache across replicas and survive
# restarts. Use the rediss:// (TLS) scheme for a hosted provider.
REDIS_URL=

# Cache TTLs in seconds (src/utils/cache.js). All optional — the defaults in
# brackets are used when unset.
CACHE_TTL_VENUE_NAMES=200      # [200]
CACHE_TTL_VENUE_LIST=200       # [200]
CACHE_TTL_VENUE_DETAIL=300     # [300]
CACHE_TTL_ADMIN_VENUES=120     # [120]
CACHE_TTL_EVENTS_FEED=120      # [120]
CACHE_TTL_EVENT_DETAIL=300     # [300]
CACHE_TTL_USER_PROFILE=300     # [300]
CACHE_TTL_PULSE_MAP=60         # [60]
CACHE_TTL_PULSE_STATS=60       # [60]


# --- Transactional email (password reset) ---------------------------------------
# Two transports in src/utils/mailer.js; MAIL_API_KEY wins when both are set.
# Leave BOTH unset locally: the mailer then prints each email — reset link
# included — to the API log, so the flow is testable with no credentials.
#
# MAIL_API_KEY: Brevo HTTPS API key, starts "xkeysib-" (Brevo -> SMTP & API ->
# API Keys). This is NOT the SMTP key ("xsmtpsib-") — they are different
# credentials. REQUIRED ON RENDER: Render blocks outbound SMTP ports on free web
# services (https://render.com/docs/free), so port 587 hangs until it times out
# with "Connection timeout" and nothing ever reaches the provider. Port 443 is
# never blocked, which is why a deployment must use the API transport.
MAIL_API_KEY=

# Override only when switching provider (must accept Brevo's request shape).
# Default: https://api.brevo.com/v3/smtp/email
MAIL_API_URL=

# SMTP fallback — used only while MAIL_API_KEY is empty. Fine for local work.
# Brevo: smtp-relay.brevo.com:587 (300/day free). Gmail: smtp.gmail.com:587 with
# an App Password. Mailtrap for a staging inbox that never delivers.
# Port 587 = STARTTLS (default), 465 = implicit TLS. User/pass may be omitted for
# a credential-less local relay such as MailHog or Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The From header. MUST be an address the provider has verified (Brevo ->
# Senders, Domains & IPs), or the message is rejected with "the sender you used
# ... is not valid" — over SMTP that arrives AFTER a 250, so the app logs a
# successful send for mail that was never delivered. A freemail address
# (…@gmail.com) works but never DMARC-aligns through a relay, so Gmail/Yahoo/
# Outlook file it as spam. Before launch: authenticate the real domain in the
# provider (DKIM + SPF DNS records) and send as no-reply@yourdomain.
MAIL_FROM=FunTurf <no-reply@example.com>

# Optional. Where user replies go, if you want them somewhere a human reads.
MAIL_REPLY_TO=

# Origin of the FRONTEND (not this API) — used to build the emailed reset link
# `${FRONTEND_URL}/reset-password?token=...`. Trailing slash is stripped.
# Set this to the Vercel origin on Render, or every reset link points at the
# recipient's own machine.
FRONTEND_URL=http://localhost:3000

# Reset-link lifetime in minutes. Clamped to 5..120 by the controller so a typo
# cannot mint a one-minute or one-year link. Default 30.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# LOCAL TESTING ONLY — and only needed when NODE_ENV=production on a laptop.
# Forces the mailer's log-only fallback back on so reset links appear in the API
# log. NEVER set this on a deployment: it writes live password reset links into
# the log file, which turns log access into account takeover.
MAIL_DEV_LOG=


# --- Media / images -------------------------------------------------------------
# Cloudinary credentials for server-side uploads (src/utils/mediaUpload.js).
# The cloud name is currently hardcoded to "funturf" in that file.
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Optional, comma-separated. Extra hostnames allowed to serve profile images
# beyond the built-in allowlist in src/utils/imageUrl.js.
PROFILE_IMAGE_HOSTS=


# --- API docs ---------------------------------------------------------------------
# Swagger UI at /api/v1/docs is off when NODE_ENV=production. Set to `true` to
# force it on (this repo's local .env sets production even on a laptop). Do not
# enable it on a public deployment.
DOCS_ENABLED=


# --- Load testing -------------------------------------------------------------------
# Requests carrying this value in the `x-loadtest-token` header skip ALL rate
# limiters — including the password-reset ones. Local and staging ONLY; leaving
# it set on production disables your abuse protection entirely.
# Generate with: cd ../../load-tests && npm run token
LOAD_TEST_BYPASS_TOKEN=


# --- Database seeding (scripts only, not read by the running app) -------------------
# See prisma/postgresql/seed.js.
#
# SEED_IMAGES        cdn | placeholder            (default: cdn)
# CDN_BASE           https://res.cloudinary.com/<cloud>/image/upload/v1/seed
# SEED_ALLOW_REMOTE  set to 1 to bypass the localhost-only guard. The guard
#                    exists so a seeder run cannot wipe the live database by
#                    accident — do not set this casually.
# PRISMA_DIRECT_CONNECTION  set to 1 to force the unpooled URL; the seed scripts
#                    already do this for you.
SEED_IMAGES=
CDN_BASE=
SEED_ALLOW_REMOTE=
